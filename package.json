{
  "name": "minilab-hub",
  "version": "0.1.0",
  "description": "Desktop HUB application for the Arturia MiniLab 3 MIDI controller",
  "main": "src/main/main.js",
  "scripts": {
    "build:native": "cmake --build native/audio-engine/build --config Release --target mlh_audio_engine -- /m:1",
    "build:native:tests": "cmake --build native/audio-engine/build --config Release --target mlh_native_tests -- /m:1",
    "package": "npm run build:native && npm run sync:dist",
    "start": "npm run package && node scripts/launch-dist.mjs",
    "test": "node --test \"test/*.test.mjs\" \"test/*.test.cjs\"",
    "check": "node scripts/check-invariants.mjs",
    "sync:dist": "node scripts/sync-dist.mjs"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.4.0",
    "rcedit": "^5.0.2"
  }
}
