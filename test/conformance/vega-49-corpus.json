    {
      "id": "pressure-decodes-on-its-declared-channel",
      "why": "channel pressure names no note and no controller number, so the binding that answers is found by kind and channel alone. Until this case the kind was declarable and decoded to nothing; the fixture declares it on channel 2, so this also says the channel of a number-less kind is matched rather than assumed",
      "sourceName": "Vega49 Keys",
      "bytes": [
        209,
        90
      ],
      "parsed": {
        "type": "channelpressure",
        "channel": 2,
        "value": 90,
        "raw": [
          209,
          90
